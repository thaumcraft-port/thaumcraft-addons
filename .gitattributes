* text=auto eol=lf

# Binaries - never touch
*.jar   binary
*.zip   binary
*.png   binary
*.jpg   binary
*.ogg   binary

# Windows scripts keep CRLF
*.ps1   text eol=crlf

# Source / config / docs use LF
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
